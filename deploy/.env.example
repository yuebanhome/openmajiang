# Copy to deploy/.env; never commit real credentials. Compose reads this file
# through --env-file; it is not copied into the application image.
OPENMAJIANG_IMAGE=your-dockerhub-user/openmajiang:main
PUBLIC_BASE_URL=http://localhost:8080
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
# Generate: openssl rand -base64 32
AUTH_MAIL_KEY=replace-with-base64-encoded-32-random-bytes
# Generate a DIFFERENT key: openssl rand -base64 32
TOKEN_HASH_KEY=replace-with-a-different-base64-encoded-32-byte-key
COOKIE_SECURE=false
# Empty means direct clients only. Behind a reverse proxy, trust only its exact
# source IP/CIDR (as observed by the application), never 0.0.0.0/0 or ::/0.
TRUSTED_PROXY_CIDRS=
# Local Mailpit: docker compose --env-file deploy/.env -f deploy/compose.yaml --profile dev-mail up -d
SMTP_ADDR=mailpit:1025
SMTP_FROM=OpenMajiang <noreply@localhost>
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
# Production: use https PUBLIC_BASE_URL, COOKIE_SECURE=true, a real SMTP
# endpoint with SMTP_STARTTLS=true, and an immutable image@sha256 digest.
